# Copy this file to .env and fill it in. Never commit .env.

# Google AI Studio key
GEMINI_API_KEY=
# Run `python -m app.tools.list_models` and paste a model that supports
# embedContent here.
GEMINI_EMBED_MODEL=

# Used from phase 2 on (fallback model)
OPENROUTER_API_KEY=

# Optional overrides
# CHROMA_DIR=data/chroma
# REPOS_DIR=data/repos
# CHUNK_MAX_CHARS=3000
# EMBED_BATCH_SIZE=50
# EMBED_PAUSE_SECONDS=0.5
