# Copy this file to .env and fill it in. Never commit .env.

# Google AI Studio key
GEMINI_API_KEY=
# Run `python -m app.tools.list_models` and paste a model that supports
# embedContent here. If you change it later, rebuild the index with --reset.
GEMINI_EMBED_MODEL=

# Model that writes the answers (phase 2). This one is a stable name.
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Fallback, used only when Gemini is busy or down (429 / 5xx / no network).
# Leave both empty to run without a fallback.
# Run `python -m app.tools.list_openrouter_models` to pick a model id.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional overrides
# TOP_K=6
# CHAT_TEMPERATURE=0.2
# CHROMA_DIR=data/chroma
# REPOS_DIR=data/repos
# CHUNK_MAX_CHARS=3000
# EMBED_BATCH_SIZE=50
# EMBED_PAUSE_SECONDS=0.5
# CHAT_MAX_OUTPUT_TOKENS=0   # 0 sends no limit. Try 8192 if answers come back cut off (finish reason MAX_TOKENS)
